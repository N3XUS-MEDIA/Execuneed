# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Execuneed Financial Services
# The WhatsApp number is NOT an env var. It comes from
# OrganisationSettings.whatsappE164 so it can be corrected without a deploy,
# and the sticky button hides itself while it is empty.
NEXT_PUBLIC_PHONE_DISPLAY=021 552 8989

# Database
DATABASE_URL=postgresql://execuneed:execuneed@localhost:5432/execuneed?schema=public

# Auth
AUTH_SECRET=replace-with-32-plus-chars
# Auth.js v5 infers the host from request headers. Only set AUTH_URL if you are
# behind a proxy that rewrites it. Setting it wrong forces every redirect to
# that origin, which breaks preview deploys and non-default ports.
# AUTH_URL=
AUTH_TRUST_HOST=true

# Email
EMAIL_FROM=Execuneed <noreply@execuneed.co.za>
RESEND_API_KEY=

# WhatsApp Cloud API (P2)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# AI (staff drafts only — never public advice)
ANTHROPIC_API_KEY=
AI_PUBLIC_ENABLED=false
AI_STAFF_ENABLED=false

# Storage
S3_ENDPOINT=
S3_REGION=af-south-1
S3_BUCKET=execuneed-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Jobs
# Shared secret for /api/cron/daily-digest. The route refuses outright when
# this is unset rather than defaulting open. Generate with `openssl rand -hex 32`.
CRON_SECRET=
# Comma separated. Confirm with the practice before switching sending on.
DIGEST_RECIPIENTS=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Analytics (no client financial data)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
GOOGLE_ADS_CONVERSION_ID=

# Development workspace webhook (already configured in Claude accounts)
DEV_WORKSPACE_WEBHOOK_URL=
N3XUS_DEV_WEBHOOK_URL=

# Preview
ALLOW_INDEXING=false
