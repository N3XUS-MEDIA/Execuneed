{
  "name": "execuneed",
  "private": true,
  "version": "0.1.0",
  "description": "Execuneed website and practice platform \u2014 N3XUS Media",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @execuneed/web dev",
    "build": "pnpm --filter @execuneed/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json}\"",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @execuneed/db generate",
    "db:migrate": "pnpm --filter @execuneed/db migrate",
    "db:seed": "pnpm --filter @execuneed/db seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
